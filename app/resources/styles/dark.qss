QWidget {
    color: #e6edf7;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow,
QDialog#resultPanel,
QDialog#historyView,
QWidget#centralWidget {
    background-color: #090d14;
}

QLabel#historyTitle {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 700;
}

QLabel#historyEmptyLabel {
    color: #8d99ab;
    font-size: 16px;
}

QTableWidget#historyTable {
    color: #d9e0ea;
    background-color: #0e141e;
    alternate-background-color: #111924;
    border: 1px solid #242d3d;
    border-radius: 10px;
    gridline-color: #242d3d;
    selection-color: #ffffff;
    selection-background-color: #46389e;
}

QTableWidget#historyTable::item {
    padding: 8px;
    border: none;
}

QHeaderView::section {
    padding: 9px 8px;
    color: #aab4c3;
    background-color: #151c28;
    border: none;
    border-right: 1px solid #242d3d;
    border-bottom: 1px solid #242d3d;
    font-weight: 600;
}

QLabel#resultTitle {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 700;
}

QFrame#resultSummaryCard {
    background-color: #111722;
    border: 1px solid #2a3445;
    border-radius: 12px;
}

QLabel#resultCardTitle {
    color: #a78bfa;
    font-size: 15px;
    font-weight: 600;
}

QLabel#resultMetric {
    color: #c8d0dc;
}

QLabel#savingsLabel {
    color: #55d6a6;
    font-size: 16px;
    font-weight: 600;
}

QLabel#savingsLabel[increased="true"] {
    color: #f0a868;
}

QPushButton#secondaryButton {
    color: #c8d0dc;
    background-color: #171e2a;
    border-color: #354158;
}

QFrame#header {
    background-color: transparent;
    border: none;
}

QLabel#brandLabel {
    color: #a78bfa;
    font-size: 20px;
    font-weight: 700;
}

QLabel#pageTitle {
    color: #f8fafc;
    font-size: 30px;
    font-weight: 700;
}

QLabel#pageSubtitle,
QLabel#settingsPlaceholder,
QLabel#dropHint,
QLabel#dropOrLabel {
    color: #8d99ab;
}

QLabel#settingsTitle {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 600;
}

QLabel#sectionLabel {
    color: #cfd7e3;
    font-size: 14px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: #8d99ab;
}

QLabel#qualityValue {
    color: #a78bfa;
    font-weight: 600;
}

QLabel#qualityValue:disabled {
    color: #667085;
}

QFrame#previewCard,
QFrame#settingsCard {
    background-color: #111722;
    border: 1px solid #242d3d;
    border-radius: 18px;
}

QFrame#previewCard {
    background-color: #0e141e;
}

QWidget#previewWidget,
QWidget#previewPage,
QLabel#previewImage {
    background-color: transparent;
    border: none;
}

QFrame#fileInfoBar {
    background-color: #0b111a;
    border: 1px solid #242d3d;
    border-radius: 10px;
}

QLabel#fileName {
    color: #e6edf7;
    font-weight: 600;
}

QLabel#fileDetail {
    color: #8d99ab;
    font-size: 13px;
}

QWidget#dropZone {
    background-color: #0b111a;
    border: 2px dashed #303b4e;
    border-radius: 14px;
}

QWidget#dropZone[dragActive="true"] {
    background-color: #17152a;
    border-color: #8068ed;
}

QLabel#dropIcon {
    color: #8068ed;
    font-size: 38px;
    font-weight: 300;
}

QLabel#dropTitle {
    color: #e6edf7;
    font-size: 17px;
    font-weight: 600;
}

QWidget#dropZone[dragActive="true"] QLabel#dropIcon,
QWidget#dropZone[dragActive="true"] QLabel#dropTitle {
    color: #b7a7ff;
}

QPushButton#chooseFileButton {
    min-width: 170px;
    color: #d9e0ea;
    background-color: #1a2230;
    border-color: #354158;
}

QPushButton#chooseFileButton:hover {
    color: #ffffff;
    background-color: #24243c;
    border-color: #8068ed;
}

QPushButton#chooseFileButton:pressed {
    background-color: #17172b;
    border-color: #7158e8;
}

QPushButton#toolButton {
    min-width: 48px;
    padding: 8px 10px;
    color: #aab4c3;
    background-color: #151c28;
    border-color: #2a3445;
    font-weight: 500;
}

QPushButton#toolButton:hover {
    color: #ffffff;
    border-color: #7158e8;
}

QPushButton#toolButton:checked {
    color: #ffffff;
    background-color: #6047d2;
    border-color: #8068ed;
}

QPushButton {
    min-height: 22px;
    padding: 10px 16px;
    color: #ffffff;
    background-color: #7158e8;
    border: 1px solid #7158e8;
    border-radius: 10px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #8068ed;
    border-color: #8f7af1;
}

QPushButton:pressed {
    background-color: #6047d2;
    border-color: #6047d2;
}

QPushButton:focus {
    border-color: #b7a7ff;
}

QPushButton:disabled {
    color: #667085;
    background-color: #1a2130;
    border-color: #252e3d;
}

QPushButton#historyButton,
QPushButton#settingsButton {
    min-height: 20px;
    padding: 8px 12px;
    color: #aab4c3;
    background-color: transparent;
    border-color: transparent;
    font-weight: 500;
}

QPushButton#historyButton:hover,
QPushButton#settingsButton:hover {
    color: #f8fafc;
    background-color: #171e2a;
    border-color: #242d3d;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 22px;
    padding: 8px 10px;
    color: #e6edf7;
    selection-color: #ffffff;
    selection-background-color: #7158e8;
    background-color: #0b1018;
    border: 1px solid #2a3445;
    border-radius: 9px;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #3d4a60;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #8068ed;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    color: #667085;
    background-color: #101620;
    border-color: #202938;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    color: #e6edf7;
    selection-color: #ffffff;
    selection-background-color: #7158e8;
    background-color: #111722;
    border: 1px solid #2a3445;
    outline: none;
}

QCheckBox {
    spacing: 8px;
    color: #c8d0dc;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background-color: #0b1018;
    border: 1px solid #354158;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border-color: #8068ed;
}

QCheckBox::indicator:checked {
    background-color: #7158e8;
    border-color: #8068ed;
    image: url(__CHECK_ICON_PATH__);
}

QCheckBox:disabled {
    color: #667085;
}

QSlider::groove:horizontal {
    height: 5px;
    background-color: #273144;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #8068ed;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #f8fafc;
    border: 3px solid #7158e8;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border-color: #927df2;
}

QProgressBar#processingIndicator {
    background-color: #252e3d;
    border: none;
    border-radius: 2px;
}

QProgressBar#processingIndicator::chunk {
    background-color: #8068ed;
    border-radius: 2px;
}

QStatusBar {
    padding: 2px 24px;
    color: #7f8b9d;
    background-color: #090d14;
    border-top: 1px solid #1d2532;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    padding: 6px 8px;
    color: #f8fafc;
    background-color: #171e2a;
    border: 1px solid #354158;
    border-radius: 6px;
}

QFrame#toastNotification {
    background-color: #171e2a;
    border: 1px solid #354158;
    border-radius: 11px;
}

QFrame#toastNotification[kind="success"] {
    border-color: #2f8f70;
}

QFrame#toastNotification[kind="error"] {
    border-color: #b84c5a;
}

QLabel#toastIcon {
    min-width: 20px;
    color: #aab4c3;
    font-size: 16px;
    font-weight: 700;
}

QFrame#toastNotification[kind="success"] QLabel#toastIcon {
    color: #55d6a6;
}

QFrame#toastNotification[kind="error"] QLabel#toastIcon {
    color: #ff7b88;
}

QLabel#toastMessage {
    color: #e6edf7;
}
